{
  "name": "nimbus-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Practice project: a client status portal for a fictional market data company (Nimbus Market Data).",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "db:migrate": "npm run migrate -w apps/api",
    "db:seed": "npm run seed -w apps/api",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "test": "npm run test -w apps/api",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.6.0"
  }
}
