{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node's native ESM resolution: relative imports need the `.js`
    // extension (even in .ts files), which is what Node itself expects.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["src", "test", "vitest.config.ts"]
}
