{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite does the bundling, so TypeScript only type-checks (noEmit).
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
