# Copy this file to `.env` (same folder) and adjust if needed.
# Same database as the API (see apps/api/.env.example).

DATABASE_URL=postgres://nimbus:nimbus_dev_password@localhost:5433/nimbus

# Same Redis as the API. After each tick the simulator publishes a small
# "new data is ready" message here, so the API can push it to browsers.
REDIS_URL=redis://localhost:6380

# How often to generate a new row per feed, in seconds.
TICK_SECONDS=1

# Delete metrics older than this many minutes, so the table doesn't grow forever.
RETENTION_MINUTES=60